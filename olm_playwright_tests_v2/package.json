{
  "name": "olm-playwright-tests",
  "version": "2.0.0",
  "description": "OLM.vn test automation – Playwright TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:example": "playwright test --config=playwright.example.config.ts",
    "test:fast": "playwright test --project=chromium",
    "test:bai-tap": "playwright test --project=bai-tap --no-deps",
    "test:olm-staff": "playwright test --project=olm-staff",
    "test:smoke": "playwright test tests/smoke",
    "test:learning-core": "playwright test modules/hoc-sinh/learning-core",
    "test:modules": "playwright test modules",
    "test:giao-vien": "playwright test modules/giao-vien",
    "test:hoc-sinh": "playwright test modules/hoc-sinh",
    "test:dung-chung": "playwright test modules/dung-chung",
    "test:debug:giao-vien": "cross-env ENV_FILE=.env.debug playwright test modules/giao-vien",
    "test:debug:hoc-sinh": "cross-env ENV_FILE=.env.debug playwright test modules/hoc-sinh",

    "test:role:admin": "playwright test --grep @role_admin",
    "test:role:school": "playwright test --grep @role_school",
    "test:role:teacher-vip": "playwright test --grep @role_teacher_vip",
    "test:role:teacher-no-vip": "playwright test --grep @role_teacher_no_vip",
    "test:role:student-vip": "playwright test --grep @role_student_vip",
    "test:role:student-no-vip": "playwright test --grep @role_student_no_vip",
    "test:v2role:editable-teacher": "playwright test --grep @v2role_editableTeacher",
    "test:v2role:non-editable-teacher": "playwright test --grep @v2role_nonEditableTeacher",
    "test:v2role:olm-source-teacher": "playwright test --grep @v2role_olmSourceTeacher",
    "test:v2role:non-olm-source-teacher": "playwright test --grep @v2role_nonOlmSourceTeacher",
    "test:v2role:olm-staff": "playwright test --grep @v2role_olmStaff",

    "test:debug:role:admin": "cross-env ENV_FILE=.env.debug playwright test --grep @role_admin",
    "test:debug:role:school": "cross-env ENV_FILE=.env.debug playwright test --grep @role_school",
    "test:debug:role:teacher-vip": "cross-env ENV_FILE=.env.debug playwright test --grep @role_teacher_vip",
    "test:debug:role:teacher-no-vip": "cross-env ENV_FILE=.env.debug playwright test --grep @role_teacher_no_vip",
    "test:debug:role:student-vip": "cross-env ENV_FILE=.env.debug playwright test --grep @role_student_vip",
    "test:debug:role:student-no-vip": "cross-env ENV_FILE=.env.debug playwright test --grep @role_student_no_vip",
    "test:debug:v2role:editable-teacher": "cross-env ENV_FILE=.env.debug playwright test --grep @v2role_editableTeacher",
    "test:debug:v2role:non-editable-teacher": "cross-env ENV_FILE=.env.debug playwright test --grep @v2role_nonEditableTeacher",
    "test:debug:v2role:olm-source-teacher": "cross-env ENV_FILE=.env.debug playwright test --grep @v2role_olmSourceTeacher",
    "test:debug:v2role:non-olm-source-teacher": "cross-env ENV_FILE=.env.debug playwright test --grep @v2role_nonOlmSourceTeacher",
    "test:debug:v2role:olm-staff": "cross-env ENV_FILE=.env.debug playwright test --grep @v2role_olmStaff",

    "test:regression": "playwright test --grep @regression",
    "test:e2e": "playwright test --grep @e2e",
    "test:headed": "playwright test --headed",
    "test:login": "playwright test modules/dung-chung/auth/tests/login.smoke.spec.ts modules/dung-chung/auth/tests/login.regression.spec.ts",
    "report": "playwright show-report reports/html",
    "test:debug": "cross-env ENV_FILE=.env.debug playwright test",
    "test:debug:fast": "cross-env ENV_FILE=.env.debug playwright test --project=chromium",
    "test:debug:bai-tap": "cross-env ENV_FILE=.env.debug playwright test --project=bai-tap --no-deps",
    "test:debug:olm-staff": "cross-env ENV_FILE=.env.debug playwright test --project=olm-staff",
    "test:debug:smoke": "cross-env ENV_FILE=.env.debug playwright test --grep @smoke",
    "test:debug:regression": "cross-env ENV_FILE=.env.debug playwright test --grep @regression",
    "test:debug:e2e": "cross-env ENV_FILE=.env.debug playwright test --grep @e2e",
    "test:debug:headed": "cross-env ENV_FILE=.env.debug playwright test --headed",
    "test:debug:login": "cross-env ENV_FILE=.env.debug playwright test modules/dung-chung/auth/tests/login.smoke.spec.ts modules/dung-chung/auth/tests/login.regression.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.19.21",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "playwright": "^1.61.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}