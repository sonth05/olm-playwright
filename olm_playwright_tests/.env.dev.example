# ─────────────────────────────────────────────────────────────────────────
# Env dùng cho môi trường DEV (dev.olm.vn) — database CHUNG với bản thật.
# Copy file này thành ".env.dev" rồi điền giá trị thật, KHÔNG commit ".env.dev".
#
# Cách chạy:
#   ENV_FILE=.env.dev npx playwright test          (macOS/Linux)
#   $env:ENV_FILE=".env.dev"; npx playwright test   (Windows PowerShell)
#   npm run test:dev                                (đã cấu hình sẵn, chạy mọi OS)
# ─────────────────────────────────────────────────────────────────────────

# Base URL — chỉ khác bản chính đúng tiền tố "dev."
BASE_URL=https://dev.olm.vn

# Tài khoản test OLM – Worker 0,1,2 (gốc)
# Vì dev dùng chung database với bản thật, các tài khoản này giống hệt .env
OLM_VIP_USERNAME=hsptolm_dothilananh
OLM_VIP_PASSWORD=Thanhson2@

OLM_SCHOOL_USERNAME=nguyenthanhson2818
OLM_SCHOOL_PASSWORD=Thanhsin2@

OLM_NORMAL_USERNAME=hsptolm_tranducanh
OLM_NORMAL_PASSWORD=123456

# Tài khoản test OLM – Worker 3,4,5 (mới)
OLM_EXTRA1_USERNAME=hsptolm_nguyenminhanh
OLM_EXTRA1_PASSWORD=123456

OLM_EXTRA2_USERNAME=hsptolm_lehoangnam
OLM_EXTRA2_PASSWORD=123456

OLM_EXTRA3_USERNAME=hsptolm_sonthanh
OLM_EXTRA3_PASSWORD=123456

# Browser
HEADLESS=false
BROWSER=chromium
# Vì đây là bản dev nội bộ (build mới merge), có thể chưa ổn định bằng
# bản thật — cân nhắc giảm WORKERS nếu server dev yếu / hay bị timeout.
WORKERS=6

# Timeouts (seconds) — bản dev có thể chậm hơn bản thật (build mới, cache
# nguội), nên để dư hơn một chút so với .env gốc nếu hay gặp timeout giả.
WAIT_TIMEOUT=8
PAGE_LOAD_WAIT=2
LOGIN_WAIT=2
