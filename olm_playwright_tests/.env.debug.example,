# ─────────────────────────────────────────────────────────────────────────
# Env dùng cho môi trường DEBUG (debug.olm.vn).
# "debug" là bản dev đưa lên test mẫu TRƯỚC KHI đưa tiếp lên dev.olm.vn
# (dev.olm.vn = bản đã qua debug, chuẩn bị lên master/olm.vn thật).
# Copy file này thành ".env.debug" rồi điền giá trị thật, KHÔNG commit ".env.debug".
#
# Cách chạy:
#   ENV_FILE=.env.debug npx playwright test          (macOS/Linux)
#   $env:ENV_FILE=".env.debug"; npx playwright test   (Windows PowerShell)
#   npm run test:debug                                (đã cấu hình sẵn, chạy mọi OS)
# ─────────────────────────────────────────────────────────────────────────

# Base URL — môi trường debug (build mới nhất trước khi lên dev.olm.vn)
BASE_URL=https://debug.olm.vn

# ─── Tài khoản test trên debug.olm.vn ─────────────────────────────────────
# Debug hiện chỉ có 1 tài khoản seed sẵn (ngsonth05) → dùng CHUNG tài khoản
# này cho mọi role/worker bên dưới. Khi debug có thêm tài khoản riêng cho
# VIP/school/student thường, thay giá trị tương ứng và tăng WORKERS lại.
OLM_VIP_USERNAME=ngsonth05
OLM_VIP_PASSWORD=Thanhson2@

OLM_SCHOOL_USERNAME=ngsonth05
OLM_SCHOOL_PASSWORD=Thanhson2@

OLM_NORMAL_USERNAME=ngsonth05
OLM_NORMAL_PASSWORD=Thanhson2@

OLM_EXTRA1_USERNAME=ngsonth05
OLM_EXTRA1_PASSWORD=Thanhson2@

OLM_EXTRA2_USERNAME=ngsonth05
OLM_EXTRA2_PASSWORD=Thanhson2@

OLM_EXTRA3_USERNAME=ngsonth05
OLM_EXTRA3_PASSWORD=Thanhson2@

# Browser
HEADLESS=false
BROWSER=chromium
# Chỉ 1 tài khoản thật cho tất cả worker → chạy tuần tự để tránh cùng
# 1 session bị đăng xuất/conflict khi nhiều worker login song song.
WORKERS=1

# Timeouts (seconds) — bản debug là build mới nhất, có thể chưa ổn định
# bằng cả dev lẫn bản thật, nên để dư thời gian hơn một chút.
WAIT_TIMEOUT=10
PAGE_LOAD_WAIT=3
LOGIN_WAIT=3