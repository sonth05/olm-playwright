{
  "name": "olm-playwright-tests",
  "version": "2.0.0",
  "description": "OLM.vn test automation – Playwright TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:fast": "playwright test --project=chromium",
    "test:bai-tap": "playwright test --project=bai-tap --no-deps",
    "test:smoke": "playwright test tests/smoke",
    "test:regression": "playwright test tests/regression",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:login": "playwright test tests/smoke/login.smoke.spec.ts tests/regression/login.regression.spec.ts",
    "report": "playwright show-report reports/html",
    "thi-thu": "tsx scripts/thiThuThptSinhHoc.ts",
    "toan9": "tsx scripts/toan9Bai2PhuongPhapThe.ts",
    "auto-learning": "tsx scripts/auto-learning.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.19.21",
    "dotenv": "^16.4.7",
    "playwright": "^1.61.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}